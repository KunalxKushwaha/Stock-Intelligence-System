# Add these two lines to your existing local .env file (do not commit .env).

# MongoDB connection string.
# Local install:      mongodb://localhost:27017
# MongoDB Atlas (free tier): mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=stock_intelligence

# Secret used to sign login tokens (JWT). Generate a random one, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never reuse this value across projects, and never commit the real one.
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
